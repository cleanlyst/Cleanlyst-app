# Copy this file to .env and fill in your values.
# See docs/ENVIRONMENTS.md for full explanation of the environment strategy.

# ── Supabase ──────────────────────────────────────────────────────────────────

# Staging / Development Supabase project
VITE_SUPABASE_STAGING_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_STAGING_ANON_KEY=your-staging-anon-key

# Production Supabase project (only required when deploying to production domains)
VITE_SUPABASE_PROD_URL=https://your-prod-project.supabase.co
VITE_SUPABASE_PROD_ANON_KEY=your-prod-anon-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# SECURITY: Only publishable keys (pk_*) belong here. Secret keys (sk_*) must
# ONLY be set as Supabase Edge Function secrets — never in VITE_ variables.

VITE_STRIPE_TEST_KEY=pk_test_your-test-key
VITE_STRIPE_LIVE_KEY=pk_live_your-live-key

# ── Optional: environment label override ──────────────────────────────────────
# Vercel sets VERCEL_ENV automatically on deploys. Set VITE_VERCEL_ENV only if
# you want to override the detected environment label in local dev.
# VITE_VERCEL_ENV=development

# ── Optional: Sentry (future) ─────────────────────────────────────────────────
# If you add @sentry/vue, set this to your project's DSN.
# Leave empty to use the built-in first-party error reporter (error_events table).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Security reminder ─────────────────────────────────────────────────────────
# The following secrets must NEVER appear in VITE_ environment variables:
#   - STRIPE_SECRET_KEY (sk_live_* or sk_test_*)
#   - SUPABASE_SERVICE_ROLE_KEY
#   - Any webhook signing secrets (STRIPE_WEBHOOK_SECRET)
#   - Database passwords
# Set those via Supabase Dashboard → Settings → Edge Functions → Secrets.
